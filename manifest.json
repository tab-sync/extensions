{
  "manifest_version": 3,
  "name": "Tab Sync",
  "version": "0.1.0",
  "description": "View open tabs and captured navigation history across your browsers.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["tabs", "webNavigation", "storage", "alarms"],
  "host_permissions": ["https://*/*", "http://localhost:3000/*", "http://127.0.0.1:3000/*"],
  "background": {
    "scripts": ["shared/background-browser.js", "shared/background.js"],
    "service_worker": "shared/background-browser.js"
  },
  "action": {
    "default_title": "Tab Sync",
    "default_icon": {
      "16": "icons/icon-16.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "shared/settings.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-sync@nkson.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "browsingActivity"]
      }
    }
  }
}
